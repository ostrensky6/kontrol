# Local development defaults. Copy to .env.local only when needed.
# Do not commit real service-role keys, database passwords, or production DB URLs.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Supabase local after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-start>

# Login automatico no localhost (sem senha). So funciona em `npm run dev`
# com o Supabase local acima; em producao a rota /auth/dev-login responde 404.
# Requer SUPABASE_SERVICE_ROLE_KEY local. Deixe vazio para usar o login normal.
# DEV_AUTO_LOGIN_EMAIL=

# Production public URL, documented for reference only.
# Current Supabase project confirmed by the responsible operator on 2026-07-04:
# NEXT_PUBLIC_SUPABASE_URL=https://gkcjzwfsnoknxgpsumxi.supabase.co
#
# LEGADO / NAO USAR:
# - https://hhxwdcwphitfxywbgtju.supabase.co

# Server/admin credentials belong in Vercel Production or an audited local shell,
# not in this example file.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_AUTH_ADMIN_KEY=
# DATABASE_URL=
# POSTGRES_URL=

# E-mail dos avisos (ajuste 1 de 27/11/2026). Com SMTP_USER e SMTP_PASS o envio
# sai por SMTP (padrao: Gmail, smtp.gmail.com:465, com senha de app); sem eles,
# usa RESEND_API_KEY. Os valores ficam so na Vercel.
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Kontrol <conta@gmail.com>
